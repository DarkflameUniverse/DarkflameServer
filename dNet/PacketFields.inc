// Wire packets: (service, ID, struct, reader). An ID can have more than one struct (one per direction):
// the first that reads the whole packet is shown.
const std::vector<Entry>& Entries() {
	static const std::vector<Entry> entries{
		{ ServiceType::AUTH, static_cast<uint32_t>(MessageType::Auth::LOGIN_REQUEST), "LoginRequest", true, &ReadWith<AuthPackets::LoginRequest> },
		{ ServiceType::CHAT, static_cast<uint32_t>(MessageType::Chat::LOGIN_SESSION_NOTIFY), "LoginSessionNotify", false, &ReadWith<ChatPackets::LoginSessionNotify> },
