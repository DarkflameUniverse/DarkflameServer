<div class="col-md-6 col-lg-4">
	<div class="card h-100">
		<div class="card-header"><h5 class="mb-0">Server Status</h5></div>
		<div class="card-body">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<span>Auth Server</span>
				{% if auth.online %}
				<span class="badge text-bg-success" id="auth-status">Online</span>
				{% else %}
				<span class="badge text-bg-danger" id="auth-status">Offline</span>
				{% endif %}
			</div>
			<div class="d-flex justify-content-between align-items-center mb-3">
				<span>Chat Server</span>
				{% if chat.online %}
				<span class="badge text-bg-success" id="chat-status">Online</span>
				{% else %}
				<span class="badge text-bg-danger" id="chat-status">Offline</span>
				{% endif %}
			</div>
			<div class="d-flex justify-content-between align-items-center">
				<span>Active Worlds</span>
				<span class="badge text-bg-primary" id="world-count">{{ stats.worlds }}</span>
			</div>
		</div>
	</div>
</div>
