{% extends "base.jinja2" %}

{% block title %}Property Rent - DarkflameServer{% endblock %}

{% block content %}
<div id="propertyRentPage">
	<div class="mb-3">
		<h2 class="mb-1">Property Rent</h2>
		<p class="text-body-secondary mb-0">What owners pay for each property world, like live. Rent is taken from the owner's coins when they log in;
			if they can't pay, their property is made private after the grace period and stays private until it is paid (nothing on it changes).
			Each world starts with its PropertyTemplate rent (Block Yard is free); set a price here to change it, 0 to make it free.</p>
	</div>
	<div class="alert alert-secondary d-none" id="offNote">Rent is off: turn on <a href="/settings#property_rent_enabled"><code>property_rent_enabled</code></a> in Settings to charge it.</div>
	<div class="card">
		<table class="table table-sm align-middle mb-0 table-stack">
			<thead><tr><th>World</th><th>Template</th><th>Set here</th><th>Charged</th><th></th></tr></thead>
			<tbody id="rows"></tbody>
		</table>
	</div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/property-rent.js"></script>
{% endblock %}
