{% extends "base.jinja2" %}

{% block title %}UGC Search - DarkflameServer{% endblock %}

{% block content %}
<div id="ugcSearchPage" data-query="{{ query }}" data-can-accounts="{% if can.accounts_view %}1{% endif %}">
	<div class="mb-3">
		<h2 class="mb-1">UGC Search</h2>
		<p class="text-body-secondary mb-0">Find the models, cars and rockets players built, what the UGC server made of them and where they are.
			A number finds ids (the UGC / blueprint id, a placed model's object id, a property, character or account id) and LOTs;
			text finds creators' character and account names, property names and the names players gave their models.
			Search one field with <code>owner:</code>, <code>property:</code>, <code>model:</code>, <code>id:</code> or <code>lot:</code>.</p>
	</div>
	<form class="mb-3" id="ugcSearchForm" role="search">
		<div class="input-group">
			<input type="search" class="form-control" id="ugcSearchInput" placeholder="Name, id or LOT" aria-label="Search players' creations" autocomplete="off" maxlength="100">
			<button class="btn btn-primary" type="submit">Search</button>
		</div>
	</form>
	<div id="ugcSearchStatus" class="text-body-secondary small mb-2"></div>
	<div class="card">
		<div class="table-responsive">
			<table class="table table-sm align-middle mb-0 table-stack">
				<thead><tr><th></th><th>Creation</th><th>Made by</th><th>Where</th><th>UGC server</th></tr></thead>
				<tbody id="ugcSearchRows"><tr><td colspan="5" class="text-body-secondary">Type something to search.</td></tr></tbody>
			</table>
		</div>
	</div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/ugc-links.js"></script>
<script src="/js/ugc-search.js"></script>
{% endblock %}
