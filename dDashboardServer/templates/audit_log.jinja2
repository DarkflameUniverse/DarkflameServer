{% extends "base.jinja2" %}

{% block title %}Audit Log - DarkflameServer{% endblock %}

{% block content %}
<h2 class="mb-1">Audit Log</h2>
<p class="text-body-secondary mb-4">Administrative action history</p>

<div class="card">
	<div class="card-body">
		<table id="auditLogTable" class="table table-striped table-hover">
			<thead>
				<tr>
					<th>ID</th>
					<th>Admin</th>
					<th>Action</th>
					<th>About</th>
					<th>Description</th>
					<th>Time</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>
{% endblock %}

{% block scripts %}
<script>
$(function () {
	serverTable('#auditLogTable', '/api/tables/audit_log', [
		{ data: 'id' },
		{ data: 'account_name' },
		{ data: 'action', render: function (d) { return '<code>' + esc(d) + '</code>'; } },
		{ data: 'target_account_id', orderable: false, render: function (d, t, row) {
			var parts = [];
			if (row.target_character_id && row.target_character_id !== '0') parts.push(fmt.character(row.target_character_id, row.target_character_name));
			if (d) parts.push(row.target_account_name ? fmt.link('/accounts/' + d, row.target_account_name) : 'Account ' + esc(d));
			return parts.join('<div class="small text-body-secondary">') + (parts.length > 1 ? '</div>' : '');
		} },
		{ data: 'description', orderable: false },
		{ data: 'timestamp', render: function (d) { return fmt.unix(d); } }
	], { liveTable: 'audit_log' });
});
</script>
{% endblock %}
