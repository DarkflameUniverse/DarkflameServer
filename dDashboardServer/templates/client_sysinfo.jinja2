{% extends "base.jinja2" %}

{% block title %}Client System Info - DarkflameServer{% endblock %}

{% block content %}
<div id="sysinfoPage">
	<h2 class="mb-1">Client System Info</h2>
	<div class="alert alert-warning small" role="note">
		<strong>As reported by the client, approximate.</strong> The game client describes its system with old Windows functions called from a 32-bit program
		with no compatibility manifest. Windows answers with compatibility values (8.1, 10 and 11 all say 6.2 build 9200; the processor type is always 586),
		and under Wine or Proton the answers are whatever Wine reports. Treat this as what clients claim, not as players' real hardware.
	</div>
	<p class="text-body-secondary">From each account's newest report (<span id="sysinfoAccounts">&hellip;</span> accounts), kept for <code>log_client_sysinfo_days</code>.
		Every report is listed below; each account's own reports are also on its account page.</p>

	<div class="row g-4">
		<div class="col-lg-6">
			<div class="card h-100" id="spread-os">
				<div class="card-header"><h5 class="mb-0">Windows version reported</h5></div>
				<div class="card-body">
					<p class="small text-body-secondary" data-caveat></p>
					<div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody><tr><td class="text-body-secondary">Loading&hellip;</td></tr></tbody></table></div>
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card h-100" id="spread-video">
				<div class="card-header"><h5 class="mb-0">Video card (Direct3D adapter)</h5></div>
				<div class="card-body">
					<p class="small text-body-secondary" data-caveat></p>
					<div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody><tr><td class="text-body-secondary">Loading&hellip;</td></tr></tbody></table></div>
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card h-100" id="spread-memory">
				<div class="card-header"><h5 class="mb-0">Physical memory reported</h5></div>
				<div class="card-body">
					<p class="small text-body-secondary" data-caveat></p>
					<div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody><tr><td class="text-body-secondary">Loading&hellip;</td></tr></tbody></table></div>
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card h-100" id="spread-processors">
				<div class="card-header"><h5 class="mb-0">Logical processors reported</h5></div>
				<div class="card-body">
					<p class="small text-body-secondary" data-caveat></p>
					<div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody><tr><td class="text-body-secondary">Loading&hellip;</td></tr></tbody></table></div>
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card h-100" id="spread-clientOs">
				<div class="card-header"><h5 class="mb-0">Client build</h5></div>
				<div class="card-body">
					<p class="small text-body-secondary" data-caveat></p>
					<div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody><tr><td class="text-body-secondary">Loading&hellip;</td></tr></tbody></table></div>
				</div>
			</div>
		</div>
	</div>

	<div class="card mt-4" id="sysinfoAll">
		<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
			<h5 class="mb-0">All reports</h5>
			<div class="form-check form-switch mb-0 small">
				<input class="form-check-input" type="checkbox" id="sysinfoLatest" data-pref="client_sysinfo.latest">
				<label class="form-check-label" for="sysinfoLatest">Only each account's newest</label>
			</div>
		</div>
		<div class="card-body">
			<p class="small text-body-secondary mb-2">One row per account while its client reports the same system; a new row starts when anything but the memory
				in use changes. Dotted values have a tooltip saying what they're worth; &#9888; marks values that say little or nothing about the player's
				real system. Click a row for every field; a video card above filters the list to it.</p>
			<table id="sysinfoTable" class="table table-sm table-hover table-stack align-middle w-100">
				<thead><tr><th>Last seen</th><th>Account</th><th class="text-end">Logins</th><th data-caveat="os">Windows reported</th><th data-caveat="video">Video card</th>
					<th class="text-end" data-caveat="cpus">CPUs</th><th class="text-end" data-caveat="memory">Memory</th><th data-caveat="client">Client build</th><th>First seen</th></tr></thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/client-sysinfo.js"></script>
{% endblock %}
